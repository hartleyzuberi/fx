APP_NAME="FX Mastery"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

COURSE_AUDIT_PATH=../tmp/pdfs/source-audit
AI_ENABLED=false
AI_MAINTENANCE_MODE=false
AI_PAID_FALLBACK_ALLOWED=false
AI_LOCAL_FIRST=false
AI_PROVIDER_CHAIN=ollama,groq,gemini,openrouter,openai
AI_REQUEST_TIMEOUT=25
AI_CONNECT_TIMEOUT=4
AI_MAX_REQUESTS_PER_USER_PER_DAY=30
AI_TUTOR_COOLDOWN_SECONDS=3
AI_CIRCUIT_FAILURE_THRESHOLD=3
AI_CIRCUIT_COOLDOWN_SECONDS=120
AI_DAILY_BUDGET_USD=0
AI_MONTHLY_BUDGET_USD=0

AI_SEMANTIC_GRADING_ENABLED=false
AI_VISION_ENABLED=false
AI_EXTERNAL_RETRIEVAL_ENABLED=false
AI_SUPPLEMENTAL_KNOWLEDGE_ENABLED=false
RAG_ENABLED=true
SEMANTIC_SEARCH_ENABLED=false
AI_EMBEDDING_PROVIDER=ollama

OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_EMBEDDING_MODEL=

GROQ_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=
GROQ_COST_CLASS=free

GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_EMBEDDING_MODEL=
GEMINI_COST_CLASS=free

OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_COST_CLASS=free

OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=
OPENAI_GRADING_MODEL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
