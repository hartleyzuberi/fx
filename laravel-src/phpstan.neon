includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    ignoreErrors:
        - '#Parameter #5 \\$outline of method App\\Services\\Curriculum\\SourceIngestionService::importPageSegments\\(\\) expects list<array<string, mixed>>, array<string, mixed> given\\.#'
